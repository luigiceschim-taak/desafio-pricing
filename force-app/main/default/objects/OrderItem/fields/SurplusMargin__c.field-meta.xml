<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SurplusMargin__c</fullName>
    <formula>IF( ((TotalSellingPrice__c / TotalIdealPrice__c) - 1) &lt;= 0, 
 0,
  ((TotalSellingPrice__c / TotalIdealPrice__c) - 1)
 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Margem de Contribuição Excedente.</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
