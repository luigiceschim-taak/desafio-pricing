<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>cidade_estado_pais_validacao</fullName>
    <active>true</active>
    <errorConditionFormula>(
  IF(ISBLANK(City__c), 0, 1) + 
  IF(ISBLANK(State__c), 0, 1) + 
  IF(ISBLANK(Country__c), 0, 1)
) &lt;&gt; 1</errorConditionFormula>
    <errorMessage>Erro: Preencha apenas um campo. Cidade, Estado ou Pais.</errorMessage>
</ValidationRule>
