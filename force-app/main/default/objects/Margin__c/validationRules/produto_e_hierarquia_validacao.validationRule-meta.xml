<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>produto_e_hierarquia_validacao</fullName>
    <active>true</active>
    <errorConditionFormula>(IF(ISBLANK(  ProductHierarchy__c  ), 0, 1) + 
 IF(ISBLANK(Product__c), 0, 1)) &lt;&gt; 1</errorConditionFormula>
    <errorMessage>Preencha apenas UM campo necessário. Produto ou hierarquia.</errorMessage>
</ValidationRule>
